# App
APP_ORIGIN=http://localhost:3000
EXTERNAL_PROVIDER_MODE=live
ALLOW_FIXTURE_PROVIDERS=false
LOCAL_MAILPIT_URL=http://127.0.0.1:54324
# Required by the bounded dashboard-summary retry worker endpoint in production.
INTERNAL_WORKER_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth / YouTube Data API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/youtube/oauth/callback
YOUTUBE_TOKEN_ENCRYPTION_KEY=
# Local development only. Production must keep this false.
ENABLE_PUBLIC_YOUTUBE_DEV_MODE=false
# Server-only API key for public-video read-only testing.
YOUTUBE_PUBLIC_API_KEY=

# Data-deletion audit
DELETION_AUDIT_PEPPER=

# OpenAI
OPENAI_API_KEY=
# Legacy fallback while the existing analysis path is migrated.
OPENAI_ANALYSIS_MODEL=
OPENAI_STAGE1_MODEL=gpt-5.4-nano
OPENAI_STAGE2_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
